#HUD Config Settings

$Show Default HUD: YES
$Shield Gauge Ship: Z-95 Headhunter
$Shield Gauge Target Ship: TIE Advanced X1
$Primary Weapons: ("T&B KX-5#Reb")
$Secondary Weapons: ("Krupx MG5#Orn")
$Example Wing Names: ("Red" "Blue" "Green" "Gold" "Grey")

#HUD Global Settings

;;Gauges all use `2_` prefix since FSO hardcodes that as high_res

$Load Retail Configuration: No		; If set to Yes, FSO will load any missing gauges necessary to complete the FS1/FS2 retail configuration. 
									; If field is not present, FSO will default this to Yes.
$Font: font_hud_default
$Max Directives:  10				
$Max Escort Ships: 20
$Wireframe Targetbox: 3 ;change to 1 for wireframe 
$Targetbox Shader Effect: 3
$Lock Wireframe Mode: true

$Scale Gauges: NO 
;; Note, a NO here really means 'Do not scale gauges if the game's resolution is between the $Base and $Force Scaling resolutions'. 
;; Gauges will still always be scaled if the game's resolution is less then the $Base resolution.
;; Similarly, gauges will be scaled to the resolution of Force Scaling if Force Scaling is set (or to monitor resolution if that is larger it seems).  

;; Also note, that using the -res flag from the launcher in full screen 
;; makes the gauges look like they are not scaling correctly, even though they are.

;; With gauge scaling off, $Force Scaling Above: (1920, 1080) will scale the HUD as though it were being rendered at 1080p.
;; This is the setting most FSO mods use.

$Force Scaling Above: (1600, 900)
;; Optional. If gauge scaling is disabled, then gauges will be scaled 
;; as though the base resolution were this resolution or the real base resolution, whichever is greater.
;; Use this to disable scaling at lower resolutions while preventing gauges from getting too small at higher resolutions.

;; SLEW
	;; If set to "true", the gauge will not follow the player's head movements when using TrackIR/padlock. 
	;; i.e. should be used for gauges like the gunsight/leadsight.
	;; SLEW means stay put
	;; Looks a bit odd on some gauges, plus nice to see hud details while looking at target 
	;; Also only applies to 1st person, and HUD could be said to projected on helmet visor

;; MUST HAVE SLEW (Slew: YES ;; center)
	;; +Mini Target Shields:
	;; +Hostile Triangle:
	;; +Target Triangle:
	;; +Missile Triangles:

;; MESSAGES: (Slew: NO ;; messages)
	;; +Custom:
	;; +Directives:
	;; +Messages:
	;; +Support:
	;; +Damage:
	;; +Objective Notify:
	;; +Squad Message:
	;; +Lag:
	;; +Escort View:
	;; +Text Warnings:

;; RTT: (Slew: NO ;; rtt)
	;; +Wingman Status:
	;; +Auto Speed:
	;; +Auto Target:
	;; +Countermeasures:
	;; +Weapons:
	;; +Radar:
	;; +Player Shields:
	;; +Target Shields:
	;; +Mission Time:
	;; +ETS Weapons:
	;; +ETS Engines:
	;; +ETS Shields:
	;; +Extra Target Data:
	;; +Afterburner Energy:
	;; +Weapon Energy:
	;; +Throttle:
	;; +Threat Indicator:
	;; +Kills:

;;=============================================================================
;; Base configuration most users will see. Has no maximum, and all gauges use `Origin` and `Offset` instead of `Position`. 
;; Gauges will scale at resolutions according to `$Force Scaling Above:` values set above. 
;; Also note, that the $Base resolution only affects how much the gauges will scale by at different resolutions. 
;; The current base is set at (1600, 900) to ensure that when the game resolution is larger (up to the max set at Force Scaling) then the gauges will not be too big. 
;; If the $Base was (640, 480) then the gauges at the Force Scaling resolution of (1920, 1080) would be very large. 
;; Also note, that if Force Scaling is set, then gauges will only be scaled up to that resolution, even if the game resolution is higher. 

;; Note, there is no min or max since otherwise additional gauge config sections would be needed for gauges to show up for different resolutions.

;; Used for display in HUD configure screen
#Gauge Config
	$Base: (1600, 900)
	;$Required Aspect: Wide Screen 		; Optional. This decreases the amount of custom Gague Configs needed. 
	;$Min: (1024, 768)					; These Min and Max fields are Inclusive and optional.  
	;$Max: (7680, 4320)	
	$Gauges:

		;; RTT Start
		+Wingman Status: 
			Origin: (1.0, 0.5)
			Offset: (-175, -50)
			Font: font_hud_config
			Slew: NO ;; rtt
			Left Background Filename:		2_wingman_left
			Entry Background Filename:		2_wingman_entry
			Right Background Filename:		2_wingman_right
			Dot Filename:					2_wingmen-dots_circle
			Header Offsets:					(5, 4)
			Left Background Width:			20
			Entry Width:					20
			Last Background Offset:			-16
			Single Wing Offsets:			(0, 26)
			Multiple Wing Start Offsets:	(0, 26)
			Wing Name Offsets:				(5, 0)
			Dot Offsets:					(75, 0) (90, 0) (105, 0) (120, 0) (135, 0) (150, 0)
			Expansion Mode: 				Down
			Wingname Align Mode:            Left
			Use Full Wing Names:			YES
			Use Expanded Colors:			YES

		+Target Shields: 
			Origin: (0.0, 1.0)
			Offset: (240, -103)
			Slew: NO ;; rtt

		+Player Shields: 
			Origin: (0.5, 1.0)
			Offset: (200, -103)
			Slew: NO ;; rtt

		+Weapon Energy: 
